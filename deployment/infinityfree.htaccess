# Install this as htdocs/.htaccess; keep public/.htaccess too.
Options -Indexes
RewriteEngine On

# Private application files must never be served, even if they exist.
RewriteRule ^(?:app|bootstrap|config|database|resources|routes|vendor|tests|scripts|deployment)(?:/|$) - [F,L,NC]
# /storage is also the inventory route; only deny its private filesystem paths.
RewriteRule ^storage/(?:app|framework|logs)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|README\.md)$ - [F,L,NC]

# Enable the certificate in InfinityFree before using this HTTPS-only package.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Avoid rewriting public twice; its own .htaccess handles Laravel routes.
RewriteRule ^public(?:/|$) - [L]
RewriteRule ^(.*)$ public/$1 [L]
