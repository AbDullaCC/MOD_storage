APP_NAME="نظام إدارة المخزون"
APP_ENV=production
APP_KEY=GENERATED_BY_PACKAGE_SCRIPT
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_STAGING_DOMAIN
APP_STAGING=true

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_INFINITYFREE_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_INFINITYFREE_DATABASE_NAME
DB_USERNAME=REPLACE_WITH_INFINITYFREE_DATABASE_USERNAME
DB_PASSWORD="REPLACE_WITH_INFINITYFREE_DATABASE_PASSWORD"

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=mod_storage_staging_session
SESSION_DOMAIN=null
SESSION_ENCRYPT=true
SESSION_SERIALIZATION=json
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
